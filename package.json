{
  "name": "tokenfarm",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Personal ambient idle-farm game fueled by coding-agent token usage.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShawnMenz/TokenFarm.git"
  },
  "bugs": {
    "url": "https://github.com/ShawnMenz/TokenFarm/issues"
  },
  "homepage": "https://github.com/ShawnMenz/TokenFarm#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "TOKENFARM_DEV=1 tsx watch server/src/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx server/src/index.ts",
    "test": "tsx server/src/test/run.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "chokidar": "^4.0.0"
  }
}
